# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg://repoguide:repoguide@localhost:5432/repoguide
TEST_DATABASE_URL=postgresql+psycopg://repoguide:repoguide@localhost:5432/repoguide_test

GOOGLE_API_KEY=
GITHUB_TOKEN=

# Chat: gemini | fake. Current model names are listed in Google AI Studio.
LLM_PROVIDER=gemini
CHAT_MODEL=

# Embeddings: local | gemini | fake. Local runs on your CPU, with no API key or quota,
# and downloads the model (about 640 MB) on first use.
EMBEDDING_PROVIDER=local
# A FastEmbed model for local, or a Gemini model for gemini. Changing it means re-indexing repos.
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# Retries after the first attempt for temporary Gemini errors (429, 503).
MAX_RETRIES=3

# Gemini embeddings only: chunks per request, and the pause between requests.
EMBED_BATCH_SIZE=20
EMBED_DELAY_SECONDS=1
# Wait after a rate limit when Gemini suggests no delay, and the most one batch may wait in total.
EMBED_RATE_LIMIT_WAIT_SECONDS=60
EMBED_MAX_WAIT_SECONDS=600

DATA_DIR=./data
