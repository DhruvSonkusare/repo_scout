# Copy to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg://repoguide:repoguide@localhost:5432/repoguide
TEST_DATABASE_URL=postgresql+psycopg://repoguide:repoguide@localhost:5432/repoguide_test

GOOGLE_API_KEY=
GITHUB_TOKEN=

# Chat: gemini | fake. Current model names are listed by scripts/list_models.py.
LLM_PROVIDER=gemini
# Models to try in order. The next one answers on a 404, 429, 500, 503 or 504, but never on a 400.
# Startup checks the names against Gemini's model list, logs a warning for any it can't find and drops them.
CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
GUIDE_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# How much Gemini reasons before answering: default | minimal | low | medium | high. Less is faster.
# Gemini 3 models get this as a level and Gemini 2.5 models as a token budget. default sends nothing.
CHAT_THINKING_LEVEL=minimal
GUIDE_THINKING_LEVEL=low

# Embeddings: local | gemini | fake. Local runs on your CPU, with no API key or quota,
# and downloads the model (about 640 MB) on first use.
EMBEDDING_PROVIDER=local
# A FastEmbed model for local, or a Gemini model for gemini. Changing it means re-indexing repos.
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
# Local embeddings: auto | cuda | cpu. auto uses an NVIDIA GPU if requirements-gpu.txt is installed and
# working, and otherwise logs a line and uses the CPU. cuda fails instead of falling back.
EMBEDDING_DEVICE=auto

# Retries after the first attempt for temporary Gemini errors (429, 503). In a chat or guide chain,
# only the last model retries, because the others fall back instead.
MAX_RETRIES=3

# Gemini embeddings only: chunks per request, and the pause between requests.
EMBED_BATCH_SIZE=20
EMBED_DELAY_SECONDS=1
# Wait after a rate limit when Gemini suggests no delay, and the most one batch may wait in total.
EMBED_RATE_LIMIT_WAIT_SECONDS=60
EMBED_MAX_WAIT_SECONDS=600

DATA_DIR=./data

# Deployment. Only scripts/index_demo_repos.py reads NEON_DATABASE_URL: DATABASE_URL stays local.
NEON_DATABASE_URL=
# The public demo's limits. The Dockerfile turns DEMO_MODE on. See docs/DEPLOY.md.
DEMO_MODE=false
INDEX_PASSWORD=
MAX_REPO_SIZE_MB=20
MAX_INDEX_CHUNKS=400
RATE_LIMIT_SEARCH_PER_HOUR=10
RATE_LIMIT_ASK_PER_HOUR=30
RATE_LIMIT_GUIDE_PER_HOUR=5
RATE_LIMIT_INDEX_PER_HOUR=10
DAILY_REQUEST_CAP=100
USER_DAILY_REQUEST_CAP=30
USER_REPOS_PER_DAY=3
SIGNED_IN_DAILY_REQUEST_CAP=100
SIGNED_IN_CHUNKS_PER_DAY=400

# Sign in with GitHub. Leave any of these empty and the app runs guest-only. See docs/DEPLOY.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters.
SESSION_SECRET=
# The address visitors use, such as http://localhost:8000.
PUBLIC_BASE_URL=
